[Unit]
Description=Bluetooth headset intercom
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Type=simple
EnvironmentFile=%h/.config/rpi-intercom/environment
ExecStart=%h/.local/bin/rpi-intercom run $HEADSETS --connect
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=default.target
