#include <tunables/global>

profile bt-intercom /usr/bin/bt-intercom {
  #include <abstractions/base>

  /usr/bin/bt-intercom mr,
  /usr/bin/bluetoothctl ix,
  /usr/bin/pw-dump ix,
  /usr/bin/pw-cli ix,
  /usr/bin/pw-play ix,

  /run/dbus/system_bus_socket rw,
  dbus (send, receive) bus=system peer=(name=org.bluez),
  dbus (send, receive) bus=system peer=(name=org.freedesktop.DBus),

  /etc/bluetooth/** r,
  /etc/pipewire/** r,
  /usr/share/pipewire/** r,
  @{HOME}/.config/pipewire/** r,
  /run/user/[0-9]*/pipewire-0 rw,

  @{HOME}/.config/ rw,
  @{HOME}/.config/bt-intercom/ rw,
  @{HOME}/.config/bt-intercom/headsets rwk,
  @{HOME}/.config/bt-intercom/headsets.* rwk,
  @{HOME}/.config/bt-intercom/talk-groups.json rwk,
  @{HOME}/.config/bt-intercom/talk-groups.json.*.tmp rwk,

  /run/user/[0-9]*/ rw,
  /run/user/[0-9]*/bt-intercom-ptt-*.wav rw,
  /tmp/ rw,
  /tmp/bt-intercom-ptt-*.wav rw,

  /dev/input/event[0-9]* r,
}
