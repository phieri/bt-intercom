[23.0,"o","PTT AA:BB:CC:DD:EE:02: muted\r\nINFO: 2/2 headsets with duplex audio\r\n"]
[26.0,"o","PTT AA:BB:CC:DD:EE:01: muted\r\nINFO: 2/2 headsets with duplex audio\r\n"]
