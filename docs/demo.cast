[0.3,"o","Alex (AA:BB:CC:DD:EE:01): duplex ready (1 microphone ports, 1 speaker ports)\r\n  controller: hci0; HFP: true; A2DP: true\r\nJules (AA:BB:CC:DD:EE:02): duplex ready (1 microphone ports, 1 speaker ports)\r\n  controller: hci0; HFP: true; A2DP: true\r\nMorgan (AA:BB:CC:DD:EE:03): duplex ready (1 microphone ports, 1 speaker ports)\r\n  controller: hci1; HFP: true; A2DP: true\r\n"]
