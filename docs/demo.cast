{"version":2,"width":86,"height":18}
[0.2,"o","$ rpi-intercom --help\r\n"]
[0.7,"o","Usage: rpi-intercom scan [--seconds 1..300]\r\n       rpi-intercom pair ADDRESS\r\n       rpi-intercom status ADDRESS [ADDRESS ...]\r\n       rpi-intercom run ADDRESS [ADDRESS ...] [--interval SECONDS] [--connect] [--ptt] [--dashboard]\r\n"]
[4.0,"o","$ rpi-intercom status AA:BB:CC:DD:EE:01 AA:BB:CC:DD:EE:02\r\n"]
[4.6,"o","AA:BB:CC:DD:EE:01: duplex ready (1 microphone ports, 1 speaker ports)\r\nAA:BB:CC:DD:EE:02: duplex ready (1 microphone ports, 1 speaker ports)\r\n"]
[8.0,"o","$ rpi-intercom run AA:BB:CC:DD:EE:01 AA:BB:CC:DD:EE:02 --ptt\r\n"]
[8.5,"o","PTT: Press Enter to transmit; press Enter again to mute.\r\nINFO: 2/2 headsets with duplex audio\r\n"]
[11.0,"o","\r\nPTT: transmitting\r\nINFO: 2/2 headsets with duplex audio\r\n"]
[14.0,"o","\r\nPTT: muted\r\nINFO: 2/2 headsets with duplex audio\r\n"]
[17.0,"o","^C\r\n$ "]
